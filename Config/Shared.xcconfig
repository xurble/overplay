// Shared build settings safe to commit.

PRODUCT_NAME = Overplay
PRODUCT_BUNDLE_IDENTIFIER = com.example.Overplay
DEVELOPMENT_TEAM =

CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Overplay/Overplay.entitlements
// Mac Catalyst: sandboxed (sharing the iPad app's Mac container), no CarPlay.
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Overplay/Overplay-MacCatalyst.entitlements
INFOPLIST_FILE = Config/Info.plist
// Mac Catalyst alone supports multiple windows (its Settings window); keep
// the two files otherwise identical.
INFOPLIST_FILE[sdk=macosx*] = Config/Info-MacCatalyst.plist

ICLOUD_CONTAINER_IDENTIFIER = iCloud.com.example.Overplay

// Siri matches App Shortcut phrases exactly. With flexible matching on,
// "Start Overplay Inbox" sometimes ran the One True Playlist's "Start
// Overplay" (iOS 27, 2026-11-14).
APP_SHORTCUTS_ENABLE_FLEXIBLE_MATCHING = NO

#include? "Local.xcconfig"
